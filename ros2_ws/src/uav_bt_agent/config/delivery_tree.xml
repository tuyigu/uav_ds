<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <!-- ============================================================ -->
  <!-- MAIN TREE: Intent-Driven Reactive Architecture               -->
  <!--                                                              -->
  <!-- The Orchestrator sends intents via /orchestrator/intent.     -->
  <!-- The BT reads {intent} from Blackboard and executes.          -->
  <!-- Safety is checked every tick via ReactiveSequence.            -->
  <!-- ============================================================ -->
  <BehaviorTree ID="MainTree">
    <ReactiveSequence>

      <!-- LAYER 1: Self-health (checked every tick) -->
      <SubTree ID="SelfHealthCheck" _autoremap="true" />

      <!-- LAYER 2: Intent Router (driven by Orchestrator) -->
      <Switch4 variable="{intent}"
               case_1="DELIVER"      case_2="HOLD"
               case_3="ABORT"        case_4="RETURN_HOME">

        <!-- DELIVER: Execute the current mission leg -->
        <SubTree ID="ExecuteDeliveryLeg" _autoremap="true" />

        <!-- HOLD: Hover in place -->
        <SubTree ID="HoverInPlace" _autoremap="true" />

        <!-- ABORT: Emergency land -->
        <SubTree ID="EmergencyProcedure" _autoremap="true" />

        <!-- RETURN_HOME: Navigate home and land -->
        <SubTree ID="ReturnHome" _autoremap="true" />

        <!-- Default: Idle (no intent) -->
        <SubTree ID="IdleWait" _autoremap="true" />

      </Switch4>

    </ReactiveSequence>
  </BehaviorTree>

  <!-- ============================================================ -->
  <!-- SELF-HEALTH CHECK (every tick)                                -->
  <!-- Multi-level battery failsafe + SLAM health                   -->
  <!--                                                               -->
  <!-- Priority (checked top-to-bottom):                             -->
  <!--   1. CRITICAL battery (<10%) → Emergency Land (ABORT)         -->
  <!--   2. LOW battery (<20%) → Return Home                         -->
  <!--   3. SLAM health → Abort if unhealthy                         -->
  <!-- ============================================================ -->
  <BehaviorTree ID="SelfHealthCheck">
    <Sequence>

      <!-- Check 1: CRITICAL battery → force ABORT intent -->
      <Fallback>
        <IsBatteryOk threshold="{battery_critical}" />
        <Sequence>
          <EchoAction message="🔴 CRITICAL BATTERY! Forcing emergency land..." />
          <PublishStatusAction status="BATTERY_CRITICAL" reason="Battery critically low, emergency landing" />
          <SetBlackboard output_key="intent" value="ABORT" />
        </Sequence>
      </Fallback>

      <!-- Check 2: LOW battery → force RETURN_HOME intent -->
      <Fallback>
        <IsBatteryOk threshold="{battery_low}" />
        <Sequence>
          <EchoAction message="🟡 LOW BATTERY! Returning home..." />
          <PublishStatusAction status="BATTERY_LOW" reason="Battery low, returning to home" />
          <SetBlackboard output_key="intent" value="RETURN_HOME" />
        </Sequence>
      </Fallback>

      <!-- Check 3: SLAM health -->
      <IsSlamHealthy />

      <!-- Check 4: LinkLoss — orchestrator communication timeout -->
      <!-- 30s without intent → RETURN_HOME -->
      <Fallback>
        <IsLinkAlive timeout="{link_timeout_rtl}" />
        <Sequence>
          <EchoAction message="🔴 LINK LOST (30s)! Returning home..." />
          <PublishStatusAction status="LINK_LOST" reason="No intent for 30s, returning home" />
          <SetBlackboard output_key="intent" value="RETURN_HOME" />
        </Sequence>
      </Fallback>

      <!-- 10s without intent → HOLD (hover in place as early warning) -->
      <Fallback>
        <IsLinkAlive timeout="{link_timeout_hold}" />
        <Sequence>
          <EchoAction message="🟡 LINK DEGRADED (10s)! Holding position..." />
          <PublishStatusAction status="LINK_DEGRADED" reason="No intent for 10s, holding" />
          <SetBlackboard output_key="intent" value="HOLD" />
        </Sequence>
      </Fallback>

    </Sequence>
  </BehaviorTree>

  <!-- ============================================================ -->
  <!-- EXECUTE DELIVERY LEG                                         -->
  <!-- 5-Phase Flight: Takeoff → Cruise → Transition → Approach →  -->
  <!--                 Precision Land                                -->
  <!-- ============================================================ -->
  <BehaviorTree ID="ExecuteDeliveryLeg">
    <Sequence>

      <!-- Phase 1: Takeoff (if not airborne) -->
      <SubTree ID="Phase_Takeoff" _autoremap="true" />

      <!-- Phase 2: High-Altitude Cruise (GoTo direct, no A*) -->
      <SubTree ID="Phase_Cruise" _autoremap="true"
               goal_x="{dest_x}" goal_y="{dest_y}" cruise_z="{cruise_alt}"
               current_x="{current_x}" current_y="{current_y}" current_z="{current_z}" />

      <!-- Phase 3: Transition Descent (cruise_alt → search_alt) -->
      <!-- Skip PlannedApproach (SLAM A*) due to coordinate mismatch -->
      <SubTree ID="Phase_TransitionDescent" _autoremap="true"
               goal_x="{dest_x}" goal_y="{dest_y}"
               from_z="{cruise_alt}" to_z="{search_alt}" />

      <!-- Phase 4: A* Planned Approach (optional, graceful fallthrough on failure) -->
      <ForceSuccess>
        <SubTree ID="Phase_PlannedApproach" _autoremap="true"
                 goal_x="{dest_x}" goal_y="{dest_y}" goal_z="{search_alt}" />
      </ForceSuccess>

      <!-- Phase 5: Search + Precision Land (search_alt → ground) -->
      <SubTree ID="Phase_PrecisionLand" _autoremap="true" />

      <PublishStatusAction status="SUCCESS" />

    </Sequence>
  </BehaviorTree>

  <!-- ============================================================ -->
  <!-- PHASE 1: TAKEOFF                                              -->
  <!-- Sensors: PX4 internal (IMU + Barometer)                       -->
  <!-- Navigation: Vertical only                                     -->
  <!-- ============================================================ -->
  <BehaviorTree ID="Phase_Takeoff">
    <Fallback>
      <!-- Skip if already airborne (HOLDING, MOVING, TAKING_OFF, etc.) -->
      <!-- We check if we are NOT on ground (IDLE or LANDED) -->
      <Inverter>
         <Sequence>
             <ScriptCondition code="flight_phase == 'IDLE' || flight_phase == 'LANDED'" />
         </Sequence>
      </Inverter>
      
      <Sequence>
        <PublishStatusAction status="TAKING_OFF" />
        <RetryUntilSuccessful num_attempts="3">
          <Sequence>
            <ArmAction />
            <SetOffboardAction />
            <TakeoffAction height="{takeoff_height}" />
          </Sequence>
        </RetryUntilSuccessful>
        <PublishStatusAction status="AIRBORNE" />
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <!-- ============================================================ -->
  <!-- PHASE 2: HIGH-ALTITUDE CRUISE                                 -->
  <!-- Sensors: GPS primary + SLAM (mapping only, no planning)       -->
  <!-- Navigation: GoTo direct (no A*) — obstacles rare at altitude  -->
  <!-- Speed: Maximum                                                -->
  <!--                                                               -->
  <!-- SLAM builds OctoMap passively. If OctoMap detects obstacle    -->
  <!-- in forward path → Fallback to A* replan.                      -->
  <!-- ============================================================ -->
  <!-- ============================================================ -->
  <!-- PHASE 2: HIGH-ALTITUDE CRUISE                                 -->
  <!-- Sensors: GPS primary + SLAM (mapping only, no planning)       -->
  <!-- Navigation: GoTo direct (no A*) — obstacles rare at altitude  -->
  <!-- Speed: Maximum                                                -->
  <!--                                                               -->
  <!-- SLAM builds OctoMap passively. If OctoMap detects obstacle    -->
  <!-- in forward path → Fallback to A* replan.                      -->
  <!-- ============================================================ -->
  <BehaviorTree ID="Phase_Cruise">
    <Sequence>
      <PublishStatusAction status="CRUISING" />

      <!-- First: climb to cruise altitude (Allow 2.0m vertical error) -->
      <!-- Timeout: 30 seconds. If not reached, assuming "Good Enough" and proceed -->
      <ForceSuccess>
          <Timeout msec="30000">
             <GoToAction x="{current_x}" y="{current_y}" z="{cruise_z}" yaw="0" tolerance="2.0" />
          </Timeout>
      </ForceSuccess>

      <!-- Then: direct fly to destination at cruise altitude -->
      <!-- Reactive: if path blocked, replan with A* -->
      <!-- Tolerance: 5.0m (High altitude cruise doesn't need precision) -->
      <Fallback>
        <Timeout msec="60000">
            <GoToAction x="{goal_x}" y="{goal_y}" z="{cruise_z}" yaw="0" tolerance="5.0" />
        </Timeout>

        <!-- Fallback: obstacle detected or timeout, use A* at cruise alt -->
        <Sequence>
          <EchoAction message="Cruise obstacle detected or timeout, switching to A*" />
          <PlanPathAction
            goal_x="{goal_x}" goal_y="{goal_y}" goal_z="{cruise_z}"
            waypoints="{planned_path}" />
          <FollowPathAction waypoints="{planned_path}" />
        </Sequence>
      </Fallback>

    </Sequence>
  </BehaviorTree>

  <!-- ============================================================ -->
  <!-- PHASE 3: TRANSITION DESCENT                                   -->
  <!-- Sensors: SLAM becomes primary (GPS may drift near buildings)  -->
  <!-- Navigation: Controlled descent via GoTo                       -->
  <!-- Speed: Reduced                                                -->
  <!-- ============================================================ -->
  <BehaviorTree ID="Phase_TransitionDescent">
    <Sequence>
      <PublishStatusAction status="DESCENDING" />
      <!-- Descent allows 1.0m tolerance -->
      <RetryUntilSuccessful num_attempts="3">
         <Timeout msec="30000">
            <GoToAction x="{goal_x}" y="{goal_y}" z="{to_z}" yaw="0" tolerance="1.0" />
         </Timeout>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <!-- ============================================================ -->
  <!-- PHASE 4: A* PLANNED APPROACH                                  -->
  <!-- Sensors: SLAM primary + OctoMap active avoidance              -->
  <!-- Navigation: Full A* path planning (low altitude = obstacles)  -->
  <!-- Speed: Slow                                                   -->
  <!-- ============================================================ -->
  <BehaviorTree ID="Phase_PlannedApproach">
    <Sequence>
      <PublishStatusAction status="APPROACHING" />

      <PlanPathAction
        goal_x="{goal_x}" goal_y="{goal_y}" goal_z="{goal_z}"
        start_x="{current_x}" start_y="{current_y}" start_z="{current_z}"
        waypoints="{planned_path}" />

      <ReactiveSequence>
        <IsPathClear path="{planned_path}" />
        <!-- FollowPath logic is internal, assumes tight following. 
             If we want loose following, we'd need to modify FollowPathAction too. 
             For now, keep as is, but maybe wrap in Retry? -->
        <RetryUntilSuccessful num_attempts="2">
             <FollowPathAction waypoints="{planned_path}" />
        </RetryUntilSuccessful>
      </ReactiveSequence>

    </Sequence>
  </BehaviorTree>

  <!-- ============================================================ -->
  <!-- PHASE 5: SEARCH + PRECISION LAND                              -->
  <!-- Sensors: Camera primary (YOLO → ArUco handoff)                -->
  <!--                                                               -->
  <!-- Step 1: YOLO coarse search from search_alt (~10m)             -->
  <!-- Step 2: ArUco fine servoing from ~5m to ground                 -->
  <!-- Fallback: GPS-based blind land if all search fails            -->
  <!-- ============================================================ -->
  <BehaviorTree ID="Phase_PrecisionLand">
    <Sequence>
      <PublishStatusAction status="SEARCHING" />

      <Fallback>
        <!-- Primary: Visual precision landing -->
        <Sequence>
          <!-- Search for marker (YOLO coarse → ArUco fine) -->
          <Timeout msec="30000">
            <SearchMarkerAction marker_id="{target_marker_id}"
                                marker_x="{marker_x}" marker_y="{marker_y}" />
          </Timeout>

          <!-- Precision land using ArUco visual servoing -->
          <PublishStatusAction status="LANDING_PRECISION" />
          <RetryUntilSuccessful num_attempts="3">
            <ReactiveSequence>
              <IsMarkerVisible marker_id="{target_marker_id}" />
              <PrecisionLandAction marker_id="{target_marker_id}" />
            </ReactiveSequence>
          </RetryUntilSuccessful>
        </Sequence>

        <!-- Fallback: Land at GPS position -->
        <Sequence>
          <EchoAction message="Marker not found, landing at approximate position" />
          <PublishStatusAction status="LANDING_GPS" />
          <LandAction />
        </Sequence>

      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- ============================================================ -->
  <!-- HOVER IN PLACE (intent: HOLD)                                 -->
  <!-- ============================================================ -->
  <BehaviorTree ID="HoverInPlace">
    <Sequence>
      <PublishStatusAction status="HOLDING" reason="Operator or system hold" />
      <!-- GoTo current position = hover -->
      <GoToAction x="{current_x}" y="{current_y}" z="{current_z}" yaw="0" />
    </Sequence>
  </BehaviorTree>

  <!-- ============================================================ -->
  <!-- RETURN HOME                                                   -->
  <!-- Uses same 5-phase logic but target = home                     -->
  <!-- ============================================================ -->
  <BehaviorTree ID="ReturnHome">
    <Sequence>
      <PublishStatusAction status="RETURNING" />
      
      <!-- Ensure airborne before cruising -->
      <SubTree ID="Phase_Takeoff" _autoremap="true" />

      <!-- Climb to cruise altitude -->
      <SubTree ID="Phase_Cruise" _autoremap="true"
               goal_x="{home_x}" goal_y="{home_y}" cruise_z="{cruise_alt}"
               current_x="{current_x}" current_y="{current_y}" current_z="{current_z}" />

      <!-- Simple land at home (known location, no search needed) -->
      <GoToAction x="{home_x}" y="{home_y}" z="{search_alt}" yaw="0" />
      <LandAction />
      <PublishStatusAction status="SUCCESS" reason="Returned home" />
    </Sequence>
  </BehaviorTree>

  <!-- ============================================================ -->
  <!-- EMERGENCY PROCEDURE (intent: ABORT)                           -->
  <!-- ============================================================ -->
  <BehaviorTree ID="EmergencyProcedure">
    <Sequence>
      <EchoAction message="⚠️ EMERGENCY: Aborting mission!" />
      <PublishStatusAction status="ABORTING" reason="Emergency abort" />
      <Fallback>
        <ReturnToHomeAction />
        <EmergencyLandAction />
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- ============================================================ -->
  <!-- IDLE WAIT (no active intent)                                  -->
  <!-- ============================================================ -->
  <BehaviorTree ID="IdleWait">
    <EchoAction message="Idle: waiting for intent..." />
  </BehaviorTree>

</root>
