<?xml version="1.0"?>
<package format="3">
  <name>flight_core_v2</name>
  <version>0.2.0</version>
  <description>
    Flight Core V2 — 50 Hz single-loop UAV controller with
    B-spline path + S-curve velocity trajectory planning.
  </description>
  <maintainer email="dev@uav-ds.local">UDS Dev</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Interface generation -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- ROS 2 core -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>

  <!-- PX4 -->
  <depend>px4_msgs</depend>

  <!-- Messages used/published -->
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- Re-use existing flight_core messages/actions (Takeoff, Land, MoveTo, UavState) -->
  <depend>flight_core</depend>

  <!-- uav_web_agent for MissionStatus/MissionIntent (optional, for BT downstream) -->
  <!-- <depend>uav_web_agent</depend> -->

  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
