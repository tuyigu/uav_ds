# Goal — initiate velocity servo mode
# BT publishes velocity via /motion/velocity_cmd (geometry_msgs/Twist)
float32 timeout_sec        # abort if no completion (default 30.0)
float32 z_land_threshold   # z (ENU, m) below which to trigger Land (default 0.4)
---
# Result
bool   success    # true = z_threshold reached → land triggered
string message
---
# Feedback
float32 current_z
float32 vx_cmd     # echoed back for debugging
float32 vy_cmd
float32 vz_cmd
